{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "8bitgpu",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "8bit-players",
      "database_id": "c0825d53-8914-4749-bdc2-c421deca9654"
    }
  ],
  "vars": {
    "CHAT_ENABLED": "true",
    "CHAT_TEST_USER_IDS": "",
    "CHAT_OWNER_IDS": "98038eed-e9f0-48e6-a05c-b7d012b57388"
  }
}
