+/* Shared Appearance variables drive all taskbar chrome. */
+#osTaskbar {--bar-light:color-mix(in srgb,var(--panel),white 75%);--bar-dark:color-mix(in srgb,var(--panel),black 60%);height:46px!important;padding:4px!important;gap:5px!important;background:var(--panel)!important;color:var(--control-ink)!important;border:2px solid!important;border-color:var(--bar-light) var(--bar-dark) var(--bar-dark) var(--bar-light)!important;border-radius:0!important;box-shadow:inset 1px 1px var(--bar-light)!important;backdrop-filter:none!important;text-shadow:none!important;}
+#osTaskbar,#osTaskbar button,#osTaskbar span {font-family:var(--ui-font,Tahoma,Arial,sans-serif)!important;}
+#osTaskbar #osStartButton,#osTaskbar .os-task-tab,#osTaskbar .taskbar-social,#osTaskbar #taskbarAppearance {display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;border:2px solid!important;border-color:var(--bar-light) var(--bar-dark) var(--bar-dark) var(--bar-light)!important;border-radius:0!important;background:var(--panel)!important;color:var(--control-ink)!important;box-shadow:none!important;text-shadow:none!important;transform:none!important;filter:none!important;}
+#osTaskbar #osStartButton {flex:0 0 96px!important;width:96px!important;height:34px!important;padding:3px 8px!important;margin:0!important;gap:7px!important;font-size:14px!important;font-weight:bold;}
